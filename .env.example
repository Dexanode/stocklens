# StockLens environment variables.
# Copy to .env.local for local dev. NEVER commit real values —
# .gitignore excludes every .env* file except this example.
#
# Vikey AI key for /api/risk and /api/portfolio.
VIKEY_API_KEY=
# Vercel Blob read/write token for /api/nav-history and /api/thesis.
BLOB_READ_WRITE_TOKEN=
# WalletConnect project ID (must be a real 32-character ID). The UI disables
# the wallet modal fallback when it is not configured.
VITE_WALLETCONNECT_PROJECT_ID=
# Optional: custom RPC for /api/history (Base Sepolia registry reads).
# Defaults to https://sepolia.base.org when unset.
BASE_SEPOLIA_RPC_URL=
